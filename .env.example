# vllm-toolchest environment configuration
#
# You do not normally need this file. `./setup.sh install` detects your GPUs
# and container runtime, asks which image variant, which GPUs and which ports
# to use, and writes .env for you. It also preserves anything it does not own,
# so hand-edited values survive a later install or rebuild.
#
# This file documents what can go in .env if you would rather set it yourself:
#   cp .env.example .env
#
# Keys setup.sh manages: VLLMCTL_PORT, VLLMCTL_INFERENCE_PORT, VLLMCTL_VARIANT,
# VLLMCTL_MODELS_DIR, HIP_VISIBLE_DEVICES, GPU_ARCH, HSA_OVERRIDE_GFX_VERSION,
# HOST_VIDEO_GID, HOST_RENDER_GID.

# ─── Port configuration ─────────────────────────────────────────────
VLLMCTL_PORT=3000
VLLMCTL_INFERENCE_PORT=8000

# ─── Image variant ──────────────────────────────────────────────────
# Written by `./setup.sh install` and reused by every later command.
#   generic   ROCm + vLLM built from source, tracking vLLM main. Portable.
#   radiance  This UI layered on the third-party vllm-radiance image, tuned
#             for RDNA4 / gfx1201. Requires an R9700 / RX 9070-class card.
#             https://codeberg.org/StillDeadcode/vllm-radiance
#VLLMCTL_VARIANT=generic

# ─── GPU selection ──────────────────────────────────────────────────
# Which GPUs to hand to vLLM, by HIP index (setup.sh asks, and lists them).
# Omit the line to use every GPU -- an EMPTY value means "no GPUs" to HIP,
# not "all of them". Never use CUDA_VISIBLE_DEVICES on ROCm.
#HIP_VISIBLE_DEVICES=0,1

# ─── Model storage ──────────────────────────────────────────────────
# Bind-mount a host directory for model persistence across container rebuilds.
# Used with: docker compose -f docker-compose.yml -f docker-compose.models.yml up
#VLLMCTL_MODELS_DIR=/home/user/llm-models

# ─── HuggingFace ────────────────────────────────────────────────────
# Required for gated models (Llama, Mistral, Gemma, etc.)
#HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── API Key ────────────────────────────────────────────────────────
# Protect the /v1 proxy endpoint with a Bearer token
#VLLMCTL_API_KEY=

# ─── vLLM defaults ──────────────────────────────────────────────────
# These can also be set in the web UI (Settings page)
#VLLM_GPU_MEMORY_UTIL=0.90
#VLLM_MAX_MODEL_LEN=0
#VLLM_TENSOR_PARALLEL_SIZE=1
#VLLM_TOOL_USE_ENABLED=true

# ─── AMD ROCm settings ──────────────────────────────────────────────
# Auto-detected. Only override if needed.
#HSA_OVERRIDE_GFX_VERSION=12.0.1

# Host group IDs for GPU device access inside the container.
# Find with: getent group video | cut -d: -f3
#HOST_VIDEO_GID=
#HOST_RENDER_GID=

# ─── Build pinning ─────────────────────────────────────────────────
# AMD ROCm release from repo.radeon.com. 7.2.1 supports RDNA4 (gfx1201).
#ROCM_VERSION=7.2.1
#VLLM_VERSION=main

# Target GPU architecture(s). Semicolon-separated list for multi-arch builds.
# Defaults to gfx1201 (RDNA4: R9700, RX 9070/XT) + gfx1100 (RDNA3: 7900 XTX, W7900).
# Narrow to a single arch to shrink build time and wheel size.
#GPU_ARCH=gfx1201;gfx1100

# ─── Radiance variant ───────────────────────────────────────────────
# Only used when VLLMCTL_VARIANT=radiance.

# Base image and the vLLM tag it was built against. These must move together:
# the FP8 tuner script is fetched from that tag and the build asserts the
# image's actual vLLM version matches.
# Keep the docker.io/ prefix: podman fails on the unqualified name.
#RADIANCE_IMAGE=docker.io/stilldeadcode/vllm-radiance:0.9.3
#RADIANCE_VLLM_VERSION=v0.27.1

# Feature switches. LEAVE THESE COMMENTED unless you are changing one: an
# empty value is not "unset", it reads as "off" and disables the feature.
# All of them can also be set from the Settings page in the web UI.
#
# Master switch for the hand-written gfx1201 kernel library (attention, gated
# delta net, vision attention, all-reduce, skinny GEMM). 0 = all stock paths.
#RADIANCE_USE_R4D=1
# TP=2 P2P one-shot all-reduce (0 keeps RCCL; bit-identical either way).
#RADIANCE_USE_R4D_AR=1
# Compressed all-reduce payload. NOT bit-identical to RCCL; 0 for exact bf16.
#RADIANCE_USE_R4D_AR_QUANT=1
#RADIANCE_PRESHUFFLE=1
#RADIANCE_FUSE_RMS_QUANT=1
# Skinny bf16 GEMM: 1 = clear-win shapes, "all" adds shapes that differ from
# rocBLAS at a bf16 ULP, 0 = off.
#RADIANCE_SKINNY_GEMM=1
#
# Speculative drafting (only applies to models started with a speculative
# config). Lossless either way -- the target verifies every drafted token.
#RADIANCE_DYNAMIC_DRAFT=1
#RADIANCE_DRAFT_SCHEDULE=1:8,2:7,4:6,8:5,16:4
# Keep TAU in sync with FAST_DRAFT: 0.28 is tuned for the 2-bit head,
# 0.35 for the stock bf16 one. Crossed values draft deeper than they pay for.
#RADIANCE_DRAFT_TAU=0.28
#RADIANCE_FAST_DRAFT=1
#
# Startup topology + bandwidth sweep (backgrounded, ~1s).
#RADIANCE_RUN_BWTEST=1
# Pin the vLLM fleet to GPU-local NUMA node(s): auto, or explicit (0 / 0,1).
# No-op on single-node hosts. Needs the SYS_NICE capability.
#RADIANCE_NUMA_BIND=auto
