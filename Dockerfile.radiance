# ── vllm-toolchest on vllm-radiance ────────────────────────────────────────
#
# The RDNA4 variant. Instead of building a vLLM stack (Dockerfile.rocm), this
# layers the vllmctl management binary onto the vllm-radiance image:
#
#   https://codeberg.org/StillDeadcode/vllm-radiance
#
# vllm-radiance is a from-source ROCm + PyTorch + Triton + AITER + vLLM stack
# compiled for gfx1201, carrying RDNA4 correctness patches, tuned GEMM /
# attention / all-reduce paths, the libr4d hand-written kernel library, and a
# dynamic MTP draft controller. Reproducing that here would mean re-deriving
# ~20 source patches against a moving vLLM tag on every upstream bump, so we
# consume the image and add the UI on top.
#
# Why this works despite bypassing radiance's ENTRYPOINT: radiance installs its
# runtime hooks through vLLM's *plugin loader*, which runs per-process on every
# `vllm serve`. It does not depend on the entrypoint script. vllmctl spawns the
# server as a child process and still gets the full radiance stack. We point
# the launcher at radiance_entrypoint.sh anyway (see internal/vllmenv) so its
# banner, NUMA binding and bandwidth sweep land in our log stream too.
#
# Trade-off worth knowing before you pick this variant: radiance pins vLLM and
# transformers to specific versions, so model support is frozen at that release
# level. The generic image tracks vLLM main. See README.md.

# ── Build args ─────────────────────────────────────────────────────────────
# Declared before the first FROM so they are global: an ARG declared inside a
# stage is scoped to that stage, and both the fetch stage and the runtime stage
# need VLLM_VERSION. Each stage re-declares them to pull the default in.
#
# RADIANCE_IMAGE and VLLM_VERSION must move together — the tuner benchmark
# script is fetched from the vLLM tag the radiance image was built against, and
# the build asserts the two agree.
ARG RADIANCE_IMAGE=stilldeadcode/vllm-radiance:0.9.3
ARG VLLM_VERSION=v0.27.1
ARG GPU_ARCH=gfx1201

# ── Stage 1: Go builder ─────────────────────────────────────────────────────
FROM golang:1.26-bookworm AS go-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o vllmctl ./cmd/vllmctl

# ── Stage 2: fetch the tuner benchmark from the matching vLLM tag ───────────
# The kernel-tuning feature drives vLLM's own benchmark_w8a8_block_fp8.py. The
# generic image copies it out of the vLLM source tree it just built; the
# radiance release image ships no source tree, so we fetch that one file from
# the exact tag radiance compiled. Pin it to radiance's VLLM_VERSION — a script
# from a different release can reference kernels this vLLM does not have.
FROM alpine:3.22 AS tuner-fetch
ARG VLLM_VERSION
RUN apk add --no-cache curl && \
    curl -fsSL -o /benchmark_w8a8_block_fp8.py \
      "https://raw.githubusercontent.com/vllm-project/vllm/${VLLM_VERSION}/benchmarks/kernels/benchmark_w8a8_block_fp8.py" && \
    head -c 200 /benchmark_w8a8_block_fp8.py

# ── Stage 3: the runtime image ─────────────────────────────────────────────
FROM ${RADIANCE_IMAGE}

# Re-declare after FROM: global ARGs are not visible inside a stage until the
# stage names them again.
ARG RADIANCE_IMAGE
ARG VLLM_VERSION
ARG GPU_ARCH
ENV GPU_ARCH=${GPU_ARCH} \
    VLLMCTL_IMAGE_VARIANT=radiance

LABEL org.opencontainers.image.base.name="${RADIANCE_IMAGE}" \
      org.opencontainers.image.description="vllm-toolchest UI on the vllm-radiance RDNA4 stack" \
      org.opencontainers.image.source="https://codeberg.org/StillDeadcode/vllm-radiance"

# curl and ca-certificates already come from the radiance release stage (its
# healthcheck uses curl), so there is nothing to apt-get here. rocm-smi lives
# in the pruned ROCm tree; the monitor falls back to sysfs if it is missing.

# ── uv (for llama-benchy benchmarks) ───────────────────────────────────────
# The benchmark runner invokes `uvx llama-benchy ...`. uv is a single
# statically-linked binary, ~15 MB.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh && \
    /usr/local/bin/uv --version && /usr/local/bin/uvx --version

# ── Kernel-tuning wrapper ──────────────────────────────────────────────────
# tune_fp8_wrapper.py imports benchmark_w8a8_block_fp8 from its own directory,
# so the two must sit together.
COPY --from=tuner-fetch /benchmark_w8a8_block_fp8.py /opt/vllm-tuner/benchmark_w8a8_block_fp8.py
COPY scripts/tune_fp8_wrapper.py /opt/vllm-tuner/tune_fp8_wrapper.py

# ── AITER routing ──────────────────────────────────────────────────────────
# Unified attention ON, every other AITER path OFF. These are not defaults we
# invented: radiance's own compose sets exactly this matrix, and LINEAR=1
# crashes on gfx1201. Baked into the image (rather than left to compose) so
# `podman run` and the Quadlet unit behave the same as `docker compose up`.
ENV VLLM_ROCM_USE_AITER=1 \
    VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=1 \
    VLLM_ROCM_USE_AITER_MHA=0 \
    VLLM_ROCM_USE_AITER_MLA=0 \
    VLLM_ROCM_USE_AITER_MOE=0 \
    VLLM_ROCM_USE_AITER_LINEAR=0 \
    VLLM_ROCM_USE_AITER_FP8BMM=0 \
    VLLM_ROCM_USE_AITER_FP4BMM=0 \
    VLLM_ROCM_USE_AITER_RMSNORM=0

# ── Caches ─────────────────────────────────────────────────────────────────
# Persisted on the data volume so a restart doesn't recompile Triton/inductor
# kernels. A cold cache adds minutes before the engine comes up.
ENV NCCL_PROTO=Simple \
    TORCHINDUCTOR_COMPILE_THREADS=4 \
    VLLM_CACHE_ROOT=/data/cache/vllm \
    TORCHINDUCTOR_CACHE_DIR=/data/cache/inductor \
    TRITON_CACHE_DIR=/data/cache/triton \
    AITER_ROOT_DIR=/data/cache/aiter \
    TRITON_CACHE_AUTOTUNING=1 \
    HF_HOME=/data/cache/huggingface \
    PYTHONUNBUFFERED=1

# ── Go management binary ───────────────────────────────────────────────────
COPY --from=go-builder /app/vllmctl /usr/local/bin/vllmctl

# ── Data directories ───────────────────────────────────────────────────────
RUN mkdir -p /data/config /data/models /data/cache

RUN cat > /data/config/vllmctl.yaml << 'EOF'
listen_addr: ":3000"
data_dir: "/data"
vllm_port: 8000
log_level: "info"
tool_use_enabled: true
gpu_memory_util: 0.90
EOF

# Fail the build rather than ship an image whose management binary cannot find
# the stack it is supposed to manage. Catches a radiance base that moved its
# venv, and a tuner wrapper that lost its benchmark script.
RUN set -e; \
    test -x /opt/radiance_entrypoint.sh || { echo "FATAL: radiance entrypoint missing — is RADIANCE_IMAGE really a vllm-radiance image?"; exit 1; }; \
    test -f /opt/radiance_version       || { echo "FATAL: /opt/radiance_version missing; vllmctl would not detect the radiance variant"; exit 1; }; \
    test -d /opt/vllm/lib/python3.12/site-packages/vllm || { echo "FATAL: vLLM not at the expected venv path"; exit 1; }; \
    test -f /opt/vllm-tuner/benchmark_w8a8_block_fp8.py || { echo "FATAL: tuner benchmark script missing"; exit 1; }; \
    command -v vllm >/dev/null          || { echo "FATAL: vllm not on PATH"; exit 1; }; \
    installed="$(python -c 'import importlib.metadata as m; print(m.version("vllm"))')"; \
    want="${VLLM_VERSION#v}"; \
    case "$installed" in "$want"*) ;; *) \
      echo "FATAL: tuner script was fetched from vLLM ${VLLM_VERSION} but this image has vLLM ${installed}."; \
      echo "       Set --build-arg VLLM_VERSION=v${installed} to match RADIANCE_IMAGE."; exit 1 ;; \
    esac; \
    echo "radiance base OK: $(cat /opt/radiance_version) | vllm ${installed}"

VOLUME ["/data"]

EXPOSE 3000
EXPOSE 8000

# Replaces radiance's ENTRYPOINT. vllmctl re-invokes radiance_entrypoint.sh
# per serve, so nothing that entrypoint does is lost.
ENTRYPOINT ["vllmctl", "--config", "/data/config/vllmctl.yaml"]
