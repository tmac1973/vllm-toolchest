# ── Stage 1: Go builder ─────────────────────────────────────────────
FROM golang:1.26-bookworm AS go-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o vllmctl ./cmd/vllmctl

# ── Stage 2: vLLM runtime (NVIDIA CUDA) ────────────────────────────
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── System packages ─────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip python3-venv \
    git curl wget \
    build-essential cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

# ── Python venv ────────────────────────────────────────────────────
RUN python3 -m venv /opt/vllm-venv
ENV PATH=/opt/vllm-venv/bin:$PATH \
    VIRTUAL_ENV=/opt/vllm-venv

RUN pip install --no-cache-dir --upgrade pip setuptools wheel packaging psutil ninja

# ── vLLM (installs PyTorch and flash-attn as dependencies) ────────
ARG VLLM_VERSION=""
RUN if [ -n "${VLLM_VERSION}" ]; then \
        pip install --no-cache-dir "vllm==${VLLM_VERSION}"; \
    else \
        pip install --no-cache-dir vllm; \
    fi

# ── Additional quantization support ───────────────────────────────
# vLLM bundles GPTQ/AWQ/Marlin kernel support natively.
# bitsandbytes is needed separately for BnB 4-bit/8-bit quantization.
RUN pip install --no-cache-dir bitsandbytes

# Verify installation
RUN python3 -c "import vllm; print(f'vLLM {vllm.__version__} installed')" && \
    python3 -c "import torch; print(f'PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"

# ── uv (for llama-benchy benchmarks) ──────────────────────────────
# llama-benchy is invoked as `uvx llama-benchy ...` from the benchmark
# runner. uv ships a single statically-linked Rust binary and is small
# (~15 MB on disk).
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh && \
    /usr/local/bin/uv --version && /usr/local/bin/uvx --version

ENV HF_HOME=/data/cache/huggingface

# ── Go management binary ──────────────────────────────────────────
COPY --from=go-builder /app/vllmctl /usr/local/bin/vllmctl

# ── Data directories ──────────────────────────────────────────────
RUN mkdir -p /data/config /data/models

RUN cat > /data/config/vllmctl.yaml << 'EOF'
listen_addr: ":3000"
data_dir: "/data"
vllm_port: 8000
log_level: "info"
tool_use_enabled: true
gpu_memory_util: 0.90
EOF

VOLUME ["/data"]

EXPOSE 3000
EXPOSE 8000

ENTRYPOINT ["vllmctl", "--config", "/data/config/vllmctl.yaml"]
