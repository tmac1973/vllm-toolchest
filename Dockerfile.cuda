# ── Stage 1: Go builder ─────────────────────────────────────────────
FROM golang:1.26-bookworm AS go-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o vllmctl ./cmd/vllmctl

# ── Stage 2: vLLM runtime (NVIDIA CUDA) ────────────────────────────
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

# ── System packages ─────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip python3-venv \
    git curl wget \
    build-essential cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*

# ── Python venv ────────────────────────────────────────────────────
RUN python3 -m venv /opt/vllm-venv
ENV PATH=/opt/vllm-venv/bin:$PATH \
    VIRTUAL_ENV=/opt/vllm-venv

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# ── PyTorch (CUDA) ─────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu128

# ── Flash Attention ────────────────────────────────────────────────
RUN pip install --no-cache-dir flash-attn --no-build-isolation

# ── vLLM ───────────────────────────────────────────────────────────
ARG VLLM_VERSION=""
RUN if [ -n "${VLLM_VERSION}" ]; then \
        pip install --no-cache-dir "vllm==${VLLM_VERSION}"; \
    else \
        pip install --no-cache-dir vllm; \
    fi

# ── bitsandbytes (CUDA native) ────────────────────────────────────
RUN pip install --no-cache-dir bitsandbytes

# ── Additional quantization support ───────────────────────────────
RUN pip install --no-cache-dir auto-gptq autoawq

# Verify installation
RUN python3 -c "import vllm; print(f'vLLM {vllm.__version__} installed')" && \
    python3 -c "import torch; print(f'PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"

# ── Go management binary ──────────────────────────────────────────
COPY --from=go-builder /app/vllmctl /usr/local/bin/vllmctl

# ── Data directories ──────────────────────────────────────────────
RUN mkdir -p /data/config /data/models

RUN cat > /data/config/vllmctl.yaml << 'EOF'
listen_addr: ":3000"
data_dir: "/data"
vllm_port: 8000
log_level: "info"
tool_use_enabled: true
gpu_memory_util: 0.90
EOF

VOLUME ["/data"]

EXPOSE 3000
EXPOSE 8000

ENTRYPOINT ["vllmctl", "--config", "/data/config/vllmctl.yaml"]
